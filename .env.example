# Ably Configuration
# Required for real-time event streaming
ABLY_API_KEY=your_ably_api_key_here
ABLY_CHANNEL_PREFIX=ai-backend-generation

# Upstash Redis Configuration (REST API)
# Required for persistent checkpointing (pause/resume capability)
# Get these from your Upstash console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Azure OpenAI Configuration - GPT-4o (Planning & Debugging)
# Get from Azure Portal: Azure OpenAI > Your Resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure OpenAI Responses API (GPT-5.2 / Advanced Generation)
# Optional: For advanced code generation features
AZURE_OPENAI_RESPONSES_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/responses
AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview

# Azure Blob Storage Configuration
# Required for file persistence (PersistenceNode)
# Get from Azure Portal: Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# MCP Server Configuration (Optional)
# URL for the docs server providing Next.js/Shadcn documentation
MCP_DOCS_SERVER_URL=http://localhost:8080

# Container Build Configuration
# URL for the external build container that compiles Next.js projects
CONTAINER_BUILD_URL=http://localhost:3000/api/build

# Webhook Security
# Secret for validating incoming webhook requests
WEBHOOK_SECRET=your_webhook_secret_here

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
